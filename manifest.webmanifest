{
  "id": "/",
  "name": "ElectroMart — Mobile & Electronics Store",
  "short_name": "ElectroMart",
  "description": "ElectroMart online mobile and electronics store in Bangladesh.",
  "lang": "bn-BD",
  "dir": "ltr",
  "start_url": "/?source=installed-app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#111111",
  "categories": [
    "shopping"
  ],
  "icons": [
    {
      "src": "/icons/electromart-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/electromart-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/electromart.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
